"""Build observation from MuJoCo state matching IsaacLab training format.

Observation structure (98 dims for critic, policy uses subset):
  critic:  [base_lin_vel(3), base_ang_vel(3), root_quat(4), projected_gravity(3),
            velocity_commands(3), joint_pos(29), joint_vel(29), actions(29),
            sin_phase(1), cos_phase(1), contact_state(6), ref_traj(56),
            act_traj(56), ref_traj_vel(51), act_traj_vel(51)] = 301? No...

Actually looking at the training output, policy obs = 74, critic obs = 301.
But ONNX input is 98 - this is the ACTUAL policy input from IsaacLab exporter.

From the IsaacLab export, policy input has 98 dims. Let me check what the 98 dims are.
Looking at the existing rl_policy.py in transfer/sim/, the create_obs function builds obs from
base qpos, base qvel, joint qpos, joint qvel, time, commanded_vel.

The exported ONNX has input [1, 98]. The 98 dims come from the RSL-RL VecEnvWrapper
which concatenates policy observation groups.

The policy observation from training output was:
  policy group: base_ang_vel(3), projected_gravity(3), velocity_commands(3),
                joint_pos(29), joint_vel(29), actions(29), sin_phase(1), cos_phase(1)
  = 3+3+3+29+29+29+1+1 = 98

That matches! 98 = policy observation.

So I need to build:
- base_ang_vel: from MuJoCo qvel[3:6] (base angular velocity in local frame)
- projected_gravity: from base quaternion → project gravity vector
- velocity_commands: [vx, vy, vyaw]
- joint_pos: current joint positions (MuJoCo order → Isaac order)
- joint_vel: current joint velocities
- actions: last action sent
- sin_phase: sin(2*pi*time/total_period)
- cos_phase: cos(2*pi*time/total_period)
"""
import numpy as np

def quat_to_projected_gravity(quat):
    """Convert quaternion [w,x,y,z] to projected gravity vector."""
    qw, qx, qy, qz = quat
    g = np.zeros(3)
    g[0] = 2 * (-qz * qx + qw * qy)   # x
    g[1] = -2 * (qz * qy + qw * qx)    # y (inverted for IsaacLab convention)
    g[2] = 1 - 2 * (qw * qw + qz * qz) # z
    return g

def quat_to_base_ang_vel(quat, global_ang_vel):
    """Convert global angular velocity to local frame."""
    qw, qx, qy, qz = quat
    # Rotation matrix from world to body
    R = np.array([
        [1 - 2*qy**2 - 2*qz**2, 2*qx*qy + 2*qz*qw, 2*qx*qz - 2*qy*qw],
        [2*qx*qy - 2*qz*qw, 1 - 2*qx**2 - 2*qz**2, 2*qy*qz + 2*qx*qw],
        [2*qx*qz + 2*qy*qw, 2*qy*qz - 2*qx*qw, 1 - 2*qx**2 - 2*qy**2]
    ])
    return R @ global_ang_vel

class ObservationBuilder:
    def __init__(self, policy, mujoco_joint_names: list[str], mujoco_isaac_joint_map: list[int]):
        self.policy = policy
        self.mj_joint_names = mujoco_joint_names
        self.isaac_joint_names = policy.joint_names_isaac
        self.default_joint_pos = policy.default_joint_angles
        self.num_actions = policy.num_actions
        self.last_action = np.zeros(policy.num_actions)

        # Build MuJoCo -> Isaac joint index map
        self.mj_to_isaac = {}
        for isaac_idx, isaac_name in enumerate(self.isaac_joint_names):
            for mj_idx, mj_name in enumerate(self.mj_joint_names):
                if isaac_name == mj_name:
                    self.mj_to_isaac[mj_idx] = isaac_idx
                    break

        self.n_joints = len(self.isaac_joint_names)
        print(f"[Obs] Joint map: {len(self.mj_to_isaac)}/{self.n_joints} joints mapped")

    def set_last_action(self, action):
        self.last_action = action.copy()

    def reorder_joints(self, mj_qpos_joints, mj_qvel_joints):
        """Reorder joints from MuJoCo order to IsaacLab order."""
        isaac_pos = np.zeros(self.n_joints)
        isaac_vel = np.zeros(self.n_joints)
        for mj_idx, isaac_idx in self.mj_to_isaac.items():
            isaac_pos[isaac_idx] = mj_qpos_joints[mj_idx]
            isaac_vel[isaac_idx] = mj_qvel_joints[mj_idx]
        return isaac_pos, isaac_vel

    def build(self, mj_data, commanded_vel, sim_time, total_period=0.5):
        """Build 98-dim observation from MuJoCo state.

        Args:
            mj_data: MuJoCo MjData
            commanded_vel: [vx, vy, vyaw]
            sim_time: current simulation time
            total_period: total gait period for phasing variable
        Returns:
            obs: [98] numpy array
        """
        qpos = mj_data.qpos  # [base_pos(3), base_quat(4), joint_pos(N)]
        qvel = mj_data.qvel  # [base_lin_vel(3), base_ang_vel(3), joint_vel(N)]

        base_quat = qpos[3:7]  # [w, x, y, z]

        # 1. Base angular velocity (3): local frame
        base_ang_vel = quat_to_base_ang_vel(base_quat, qvel[3:6])

        # 2. Projected gravity (3)
        proj_gravity = quat_to_projected_gravity(base_quat)

        # 3. Velocity commands (3)
        vel_cmd = np.array(commanded_vel, dtype=np.float32)

        # 4. Joint positions (29): MuJoCo order -> Isaac order, relative to default
        joint_pos_mj = qpos[7:]
        joint_vel_mj = qvel[6:]
        joint_pos_isaac, joint_vel_isaac = self.reorder_joints(joint_pos_mj, joint_vel_mj)
        joint_pos_rel = joint_pos_isaac - self.default_joint_pos

        # 5. Joint velocities (29): Isaac order
        joint_vel_rel = joint_vel_isaac

        # 6. Last action (29)
        last_action = self.last_action

        # 7. Phase (2): sin/cos based on gait period
        phi = (sim_time % total_period) / total_period
        sin_phase = np.sin(2 * np.pi * phi)
        cos_phase = np.cos(2 * np.pi * phi)

        obs = np.concatenate([
            base_ang_vel,       # 3
            proj_gravity,       # 3
            vel_cmd,            # 3
            joint_pos_rel,      # 29
            joint_vel_rel,      # 29
            last_action,        # 29
            [sin_phase],        # 1
            [cos_phase],        # 1
        ])

        assert len(obs) == 98, f"Observation size {len(obs)} != 98"
        return obs.astype(np.float32)
