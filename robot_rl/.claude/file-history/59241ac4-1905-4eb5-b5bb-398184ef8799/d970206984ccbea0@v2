# Sim2Sim Configuration for G1 29dof Running Policy
policy:
  onnx_path: "policy.onnx"
  params_path: "policy_parameters.yaml"
  device: "cpu"  # or "cuda"

mujoco:
  model_path: "/home/ubuntu/unitree_mujoco/unitree_robots/g1/scene_29dof.xml"
  timestep: 0.002      # physics dt
  control_dt: 0.02     # policy dt (50Hz)

command:
  vx: 3.0    # forward velocity (m/s)
  vy: 0.0    # lateral velocity
  vyaw: 0.0  # yaw velocity (rad/s)

pd_gains:
  # G1 29dof joint PD gains (IsaacLab defaults)
  legs_kp: 40.0
  legs_kd: 2.5
  feet_kp: 28.0
  feet_kd: 1.8
  waist_kp: 40.0
  waist_kd: 2.5
  arms_kp: 14.0
  arms_kd: 0.9
  wrists_kp: 14.0
  wrists_kd: 0.9
