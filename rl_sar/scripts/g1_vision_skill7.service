[Unit]
Description=G1 vision Skill7 100m straight walk (rl_sar + RealSense)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/g1_running

Environment=G1_ROBOT_INTERFACE=enP8p1s0
Environment=G1_NUM7_COMMAND_OUTPUT_ENABLED=1
Environment=G1_NUM7_TARGET_M=110.0
Environment=G1_NUM7_MAX_DURATION_S=260.0
Environment=G1_NUM7_DISTANCE_SCALE=0.60
Environment=G1_NUM7_START_TIMEOUT_S=2.0
Environment=G1_NUM7_SETTLE_S=0.5
Environment=G1_VISION_MAX_VX=1.00
Environment=G1_VISION_MAX_WZ=0.25
Environment=G1_VISION_STATUS_PORT=15002

ExecStart=/home/unitree/g1_running/vision/scripts/run_skill7_robot.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
