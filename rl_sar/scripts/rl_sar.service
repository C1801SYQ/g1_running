[Unit]
Description=RL SAR G1 running Skill7 controller
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=unitree
Group=unitree
WorkingDirectory=/home/unitree/g1_running
Environment=HOME=/home/unitree
Environment=G1_ROBOT_INTERFACE=enP8p1s0
Environment=G1_RUNNING_VISION_COMMAND_OUTPUT_ENABLED=1
Environment=G1_RUNNING_VISION_TARGET_M=110.0
Environment=G1_RUNNING_VISION_CRUISE_SPEED_MPS=3.0
Environment=G1_RUNNING_VISION_MAX_DURATION_S=260.0
Environment=G1_VISION_MAX_VX=3.0
Environment=G1_VISION_MAX_WZ=0.25
Environment=G1_RUNNING_VISION_NO_OBSTACLE_STOP=1
Environment=G1_RUNNING_VISION_IMU_FORWARD_ONLY=1
Environment=G1_RUNNING_VISION_TIMEOUT_MS=300
Environment=G1_AUDIT_UDP_ENABLED=false
ExecStart=/home/unitree/g1_running/vision/scripts/run_running_vision_robot.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=20
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
